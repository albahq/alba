default check

beam check {
  description "Full verification: format, lints, tests"
  needs [fmt, lint, test]
  run "echo all checks passed"
}

beam fmt {
  description "Check formatting"
  inputs ["crates/**/*.rs"]
  run "cargo fmt --check"
}

beam lint {
  description "Clippy with warnings denied"
  inputs ["crates/**/*.rs", "Cargo.toml", "Cargo.lock"]
  run "cargo clippy --all-targets -- -D warnings"
}

# The plugin tests run the alba-executor-example binary, which
# `cargo test` does not build on its own.
beam test {
  description "Run the test suite"
  inputs ["crates/**/*.rs", "Cargo.toml", "Cargo.lock"]
  run ["cargo build --workspace", "cargo test --workspace"]
}

beam build {
  description "Release build"
  inputs ["crates/**/*.rs", "Cargo.toml", "Cargo.lock"]
  outputs ["target/release/alba"]
  run "cargo build --release"
}

beam install {
  description "Install the alba binary into the user's cargo bin"
  inputs ["crates/**/*.rs", "Cargo.toml", "Cargo.lock"]
  outputs ["{env('HOME', '')}/.cargo/bin/alba"]
  run "cargo install --path crates/alba"
}

hook pre-commit { beam fmt }
hook pre-push { beam check }
